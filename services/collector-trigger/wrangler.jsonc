{
  "name": "grow-ev-collector-trigger",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "vars": { "ENABLED": "false", "GITHUB_REF": "main" },
  // No active Cron Trigger. Approved initial activation adds 14 * * * * after disabling GitHub cron.
  "triggers": { "crons": [] },
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "CollectorCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollectorCoordinator"] }]
}
